# Copie para .env e preencha. Nunca versione o .env.

# Neon > Connection Details > "Pooled connection" (com ?sslmode=require)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/alertabueiro?sslmode=require

# Salt do hash de telefone (LGPD). Gere com: python -c "import secrets;print(secrets.token_hex(32))"
TEL_SALT=troque-por-um-valor-aleatorio

# Opcional
# MODEL_PATH=model/best.pt
# REGIAO_LAT=-23.6720
# REGIAO_LON=-46.6600

# Painel Streamlit -> API (local ou URL do Render)
API_URL=http://localhost:8000
